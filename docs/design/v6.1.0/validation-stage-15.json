  "enabled_scope": "Host typed ScenarioDefinition/PageDefinition; fixed current language Observation parents, readonly SDK/MCP; backend page-full-rebuild/1 opt-in",
  "proof": {
    "architecture": "Independent page contracts and adapter reuse ObservationService UoW, processing graph, FacetRefreshQueue, locks/CAS/outbox and finite certificates. page_block is a derived projection ledger, not a parallel factual authority; no DDL or additional scheduler.",
    "inputs": "Unit/3 pins exact actual parents, including empty parents, with head/definition digests; manifest/2 pins the full transitive header census. Full rebuild never feeds previous page content to the renderer. All actual parents are processing inputs; only output parents support blocks.",
    "versions": "Stable block identity binds scope/page/parent. Immutable block revision binds content and the entire generation manifest. A change in another parent changes even a content-identical block version. Page revision, all blocks, head/header and completion certificate publish atomically.",
    "readiness": "complete proves the fixed receipt job only; page_complete additionally proves the currently guarded head equals that unit, including certified empty; page_ready requires usable nonempty output. Not-built/building/retry/dead/empty/invalid/erased are distinguishable and failure never delivers stale content.",
    "access": "All transitive metadata, current readers/purpose, authority/floor, every source grant/version/revocation/expiry pass before any parent revision/page block/L0/L1 body; uncited inputs remain restrictive. Block content/manifest/version/page binding are checked; page_context repeats final delivery authorization.",
    "erase": "Every affected page version/block/manifest/header is physically tombstoned. Source, scope, page identity, page version, stable block and block version deletion are tested against actual SQLite backup and PostgreSQL pg_dump replay. Explicit page identity deletion disables its definition and scrubs scenario metadata; projection-version erasure does not erase independent live L1 sources.",
    "recovery": "Real independent connections serialize publication with revoke/erase; four page SIGKILL cases cover before/after commit on both backends, checking block/head/header/job atomicity and lease recovery.",
    "semantics": "Deterministic language blocks preserve actual parent facts/conflicts/time/provenance without creating new L1 facts or independent evidence. Host scenario labels are organizational metadata.",
    "compatibility": "Legacy non-page behavior passes full regression. Shared resource IDs cannot switch kinds. Backends lacking page-full-rebuild/1 advertise disabled and reject page definitions. All writers/deleters/restorers must be upgraded together.",
    "bounds": {
      "direct_parents": 4,
      "path_nodes": 4,
      "graph_nodes": 32,
      "input_bytes": 262144,
      "materialized_output_bytes": 32768,
      "per_resource_revisions": 128,
      "scope_resource_revisions": 4096,
      "scope_block_revisions_including_tombstones": 4096
    }
  },
